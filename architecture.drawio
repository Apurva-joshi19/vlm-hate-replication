<mxfile host="app.diagrams.net"><diagram id="arch" name="Architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1600" pageHeight="840"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="1. Data" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=center;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="240" height="720" as="geometry"/></mxCell><mxCell id="c2" value="2. Labels &amp; sampling" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=center;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="280" y="40" width="260" height="720" as="geometry"/></mxCell><mxCell id="c3" value="3. Semantic unification &amp; inputs" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=center;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="280" height="720" as="geometry"/></mxCell><mxCell id="c4" value="4. Classification" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=center;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="40" width="300" height="720" as="geometry"/></mxCell><mxCell id="c5" value="Replication evaluation" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=center;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="1190" y="60" width="360" height="250" as="geometry"/></mxCell><mxCell id="c6" value="Novel analysis (our contribution)&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;uses all 3 human votes per tweet&lt;/span&gt;" style="rounded=1;arcSize=3;fillColor=#fdf2f2;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=center;fontStyle=1;fontSize=13;fontColor=#b85450;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1190" y="330" width="360" height="330" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;MMHS150K&lt;/b&gt;&lt;br&gt;149,823 image tweets&lt;br&gt;text · image · OCR · 3 labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Test split&lt;/b&gt;&lt;br&gt;10,000 tweets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="55" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Train split&lt;/b&gt;&lt;br&gt;134,823 tweets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="200" height="55" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Label processing&lt;/b&gt;&lt;br&gt;exclude 2 (≠ 3 labels) → 9,998&lt;br&gt;majority vote → hate / not-hate&lt;br&gt;agreement: 3/3 vs 2/3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="220" height="95" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Stratified sample&lt;/b&gt;&lt;br&gt;3,000 = 750 × {hate, not} × {3/3, 2/3}&lt;br&gt;seed 42" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="220" height="70" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Training sample&lt;/b&gt;&lt;br&gt;20,000 random tweets&lt;br&gt;natural 21.8% hate · no test overlap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="550" width="220" height="70" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Tweet text&lt;/b&gt;&lt;br&gt;t.co links removed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="240" height="55" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;VLM: Qwen2.5-VL-3B-Instruct&lt;/b&gt;&lt;br&gt;prompt C.9, image only&lt;br&gt;→ text description" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="195" width="240" height="75" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;OCR text&lt;/b&gt;&lt;br&gt;1,238 / 3,000 tweets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="240" height="55" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Input settings&lt;/b&gt;&lt;br&gt;&lt;br&gt;(a) text only&lt;br&gt;(b) description only&lt;br&gt;(c) text + description&lt;br&gt;(d) text + OCR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="260" height="255" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;LaBSE embeddings&lt;/b&gt;&lt;br&gt;tweet text (train + test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="560" width="240" height="55" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;Robustness check&lt;/b&gt;&lt;br&gt;free generation, 240 items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="665" width="260" height="50" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;Zero-shot LLM&lt;/b&gt;&lt;br&gt;Qwen2.5-7B-Instruct (4-bit)&lt;br&gt;prompt C.3 (adapted)&lt;br&gt;prefix {&quot;hateful content&quot;:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="385" width="260" height="85" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;Decision&lt;/b&gt;&lt;br&gt;P(hate) = p(true) / (p(true) + p(false))&lt;br&gt;threshold 0.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="490" width="260" height="60" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;Logistic regression&lt;/b&gt;&lt;br&gt;with / without SMOTE (k = 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="580" width="260" height="55" as="geometry"/></mxCell><mxCell id="e1" value="P · R · F1 · AUROC&lt;br&gt;2,000 paired bootstrap 95% CI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="95" width="320" height="50" as="geometry"/></mxCell><mxCell id="e2" value="McNemar · paired ΔF1 · Holm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="165" width="320" height="40" as="geometry"/></mxCell><mxCell id="e3" value="Comparison with original (Figs. 6 &amp; 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="225" width="320" height="40" as="geometry"/></mxCell><mxCell id="n1" value="F1 / AUROC on unanimous vs split items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="375" width="320" height="45" as="geometry"/></mxCell><mxCell id="n2" value="Model as 4th annotator: Krippendorff’s α" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="435" width="320" height="45" as="geometry"/></mxCell><mxCell id